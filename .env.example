# Allowed frontend origins, separated by commas.
# Example: https://your-frontend.vercel.app
CORS_ORIGINS=

# Optional Hugging Face access token.
# Never commit your real token or paste it into chat.
HF_TOKEN=

# Optional Hugging Face repository ID for your fine-tuned text model.
# Leave empty to use the local models/text/distilbert-phishing directory.
# Example format: your-username/your-text-model
TEXT_MODEL_ID=

# Optional Hugging Face repository ID for the Wav2Vec2 audio encoder.
# Leave empty to use facebook/wav2vec2-base.
AUDIO_MODEL_ID=facebook/wav2vec2-base
